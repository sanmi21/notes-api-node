DATABASE_URL="file:./dev.db"
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=notes-api
JWT_AUDIENCE=notes-api
JWT_ACCESS_EXPIRES_IN=30m
MFA_CHALLENGE_EXPIRES_IN=5m

# Local testing only. Never enable in production.
AUTH_EXPOSE_TEST_TOKENS=false

# Password-reset delivery. Without SMTP, development prints the link in the server console.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Notes API <no-reply@example.com>

STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
LOCAL_UPLOAD_URL=/uploads

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_EXPIRES_IN=300

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=notelify
